# Copy to `.env` for local development. `.env` is git-ignored; never commit real values.
# (`.env` is a variables file. Your virtualenv is the separate folder `env/`.)
# Full reference: docs/procedures/env_vars.md

# --- Core -------------------------------------------------------------
DEBUG=True
SECRET_KEY=dev-only-insecure-key
SITE_NAME=My Site

# --- Optional: Google sign-in (docs/procedures/auth_google_oauth.md) --------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: real email via Resend (docs/procedures/email_resend.md) ------
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# --- Optional: create an admin on `manage.py bootstrap_site` ----------------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me

# --- Optional: AI (docs/procedures/openai.md) -------------------------------
# OPENAI_API_KEY=
# OPENAI_MONTHLY_COST_CAP_USD=20

# --- Optional: backups + storage (docs/procedures/gcs_bucket.md) -------------
# GCS_BUCKET=
# GCS_SERVICE_ACCOUNT=

# --- Privacy: set True once you have reviewed /privacy/ and /terms/ ---------
# PRIVACY_REVIEWED=False

# --- Optional: monitoring / alerts --------------------------------------------
# OWNER_EMAIL=you@example.com
# MONTHLY_BUDGET_USD=25

# --- Local only: drive Render from scripts/render_api.py (never set on Render) -
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
