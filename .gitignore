# Virtual environment - ALWAYS named `env`. (`.env` below is a different thing.)
env/
.venv/
venv/

# Secrets / local config. Copy .env.example to .env; never commit .env.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/

# Django runtime data (on Render these live on the persistent disk, not in git)
db.sqlite3
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
data/
media/
backups/
staticfiles/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Logs / temp
*.log
*.tmp
